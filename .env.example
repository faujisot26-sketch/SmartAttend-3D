# GEMINI_API_KEY: Required for Gemini AI API calls (if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side secrets for production deployment:
# If omitted, SmartAttend 3D generates secure ephemeral in-memory keys on startup.
SESSION_SECRET=
QR_SIGNING_SECRET=
PROFESSOR_PASSCODE=
